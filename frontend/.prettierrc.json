{
  "semi": true,
  "singleQuote": true,
  "tabWidth": 4,
  "printWidth": 100,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.json", "*.jsonc", "*.md", "*.yml", "*.yaml"],
      "options": { "tabWidth": 2 }
    },
    {
      "files": ["*.config.js", "*.config.ts", ".size-limit.js"],
      "options": { "tabWidth": 2 }
    }
  ]
}
