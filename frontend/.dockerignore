# Dependencies (Crucial to ignore!)
node_modules/
.pnp
.pnp.js

# Build Output (dist/ intentionally NOT excluded — required by Dockerfile.ci
# which receives pre-built assets from Cloud Build)
build/
coverage/

# Source maps ARE built (vite.config.ts sets sourcemap: 'hidden') so a
# production stack trace can be symbolicated, but they contain the original
# TypeScript and must not reach the image. Excluded here rather than deleted
# after the build, so the maps survive in the Cloud Build workspace for
# archiving. nginx also refuses them, for any path that bypasses this.
dist/**/*.map

# IDE & Tools
.idea/
.vscode/
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Git
.git/
.gitignore

# Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
