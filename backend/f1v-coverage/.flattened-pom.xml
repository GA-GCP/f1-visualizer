<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.elysianarts.f1.visualizer</groupId>
    <artifactId>f1v-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>f1v-coverage</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <description>Aggregate coverage report and the floor it has to clear (T3).</description>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>
  <dependencies>
    <dependency>
      <groupId>com.elysianarts.f1.visualizer.commons</groupId>
      <artifactId>f1v-commons-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.elysianarts.f1.visualizer.commons</groupId>
      <artifactId>f1v-commons-gcp</artifactId>
    </dependency>
    <dependency>
      <groupId>com.elysianarts.f1.visualizer.commons</groupId>
      <artifactId>f1v-commons-messaging</artifactId>
    </dependency>
    <dependency>
      <groupId>com.elysianarts.f1.visualizer.commons</groupId>
      <artifactId>f1v-commons-openf1</artifactId>
    </dependency>
    <dependency>
      <groupId>com.elysianarts.f1.visualizer</groupId>
      <artifactId>f1v-service-data-analysis</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.elysianarts.f1.visualizer</groupId>
      <artifactId>f1v-service-data-ingestion</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.elysianarts.f1.visualizer</groupId>
      <artifactId>f1v-service-replay-worker</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.elysianarts.f1.visualizer</groupId>
      <artifactId>f1v-service-telemetry</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.elysianarts.f1.visualizer</groupId>
      <artifactId>f1v-service-user</artifactId>
      <version>${revision}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>check</id>
            <phase>none</phase>
          </execution>
          <execution>
            <id>aggregate-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/site/jacoco-aggregate</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>aggregate-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <dataFileIncludes>
                <dataFileInclude>**/target/jacoco.exec</dataFileInclude>
              </dataFileIncludes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.coverage}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.branch.coverage}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
