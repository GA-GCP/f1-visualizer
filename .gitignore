# ==========================================
# F1 Visualizer Master .gitignore
# ==========================================

# ------------------------------------------
# 1. Secrets & Local Environments (CRITICAL)
# ------------------------------------------
*.env
*.env.*
*.env.local
*.env.development
*.env.test
*.env.production

# Frontend env files are public SPA config (Auth0 client IDs, API URLs)
# that must be present at Vite build time. These are NOT secrets.
!frontend/.env.dev
!frontend/.env.uat
!frontend/.env.prod
# The contract itself, with placeholder values only.
!frontend/.env.example
# Fake tenant values for the Playwright run; the e2e specs intercept every
# request to them, so nothing here is a credential and CI needs the file.
!frontend/.env.e2e
*.pem
*.key
secrets.json
credentials.txt

# ------------------------------------------
# 2. Infrastructure (OpenTofu & Terragrunt)
# ------------------------------------------
# Local execution directories
.terraform/
**/.terraform/
.terragrunt-cache/

.claude

# State files (Must be remote!)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files (Often contain secrets)
*.tfvars
*.tfvars.json

# Lock files and local overrides
.terraform.lock.hcl

# REL-11: Terragrunt generates backend.tf and provider.tf into each unit on every
# run. Two of them were committed, so any local run showed them as modified.
infrastructure/environments/**/backend.tf
infrastructure/environments/**/provider.tf
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ------------------------------------------
# 3. Frontend (React 19 / Vite / Node)
# ------------------------------------------
# Dependencies
**/node_modules/
.pnp
.pnp.js

# Production builds
**/dist/
**/build/

# Logs and Caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.eslintcache
.yarn-integrity

# ------------------------------------------
# 4. Backend (Java 25 / Spring Boot / Maven)
# ------------------------------------------
# Compiled class files
*.class

# Log files
*.log

# Compiled archives
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven specific
**/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml

# Written by flatten-maven-plugin at process-resources so that ${revision}
# resolves in the installed POMs, and removed again by `mvn clean`. A build that
# stops short of clean leaves them behind, where `git add -A` picks them up.
.flattened-pom.xml
buildNumber.properties
.mvn/timing.properties

# ------------------------------------------
# 5. IDEs & Operating System
# ------------------------------------------
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# VS Code
.vscode/

# Eclipse
.project
.classpath
.settings/
.metadata/
bin/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Playwright run artifacts. The report and traces are only written when a spec
# fails, and they contain full page snapshots — useful locally, not in git.
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.playwright/
