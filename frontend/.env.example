# Environment contract for the frontend build.
#
# Copy to .env.dev / .env.uat / .env.prod and fill in per environment; the mode
# is selected with `yarn build --mode <name>`. These are public SPA values, not
# secrets — the Auth0 client ID is designed to be shipped in the bundle.
#
# A bare `yarn build` loads none of these, which produces a bundle that cannot
# authenticate. Always pass --mode.

# Auth0 tenant for this environment.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://api.example.com

# Full API base URL. The STOMP broker URL is derived from its origin (+ /ws),
# so this is the only place the environment's API origin is written.
# Leave unset for local development and requests go through the Vite proxy.
VITE_API_BASE_URL=https://dev.api.example.com/api/v1

# Optional: log STOMP frames outside DEV builds (never logs the CONNECT frame).
# VITE_STOMP_DEBUG=true

# Optional: RUM collector for Web Vitals (LCP/INP/CLS/TTFB/FCP), posted with
# sendBeacon. Unset means the metrics are measured and logged in DEV but not
# sent anywhere — there is deliberately no default endpoint, because posting to
# one that does not exist would 404 on every page view.
# Whatever origin is used here must also be added to `connect-src` in the CSP
# map at the top of nginx.conf.
# VITE_RUM_ENDPOINT=https://rum.example.com/collect
