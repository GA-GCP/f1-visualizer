# Playwright run only. Every request to this tenant is intercepted by
# e2e/fixtures/auth0.ts and never leaves the browser, so these are placeholders
# rather than credentials — the domain is a reserved .test name that does not
# resolve, which is itself a safety net: if the stub ever stops matching, the
# test fails on DNS rather than reaching a real tenant.
VITE_AUTH0_DOMAIN=auth.e2e.test
VITE_AUTH0_CLIENT_ID=e2e-client-id
VITE_AUTH0_AUDIENCE=https://api.e2e.test

# VITE_API_BASE_URL is deliberately unset: it falls back to the relative
# /api/v1, which keeps REST calls same-origin and routable with a single
# page.route('**/api/v1/**'). The STOMP URL derives from the same fallback, so
# the socket is ws://127.0.0.1:4173/ws/websocket and routeWebSocket can mock it.
