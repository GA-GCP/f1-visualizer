# The browser tests' run only. Chrome reaches this tenant at the stand-in in
# e2e/stand-ins/auth0.ts, on 127.0.0.1, through a host-resolver rule its tests
# start it with (e2e/browser.ts), so these are placeholders rather than
# credentials — the domain is a reserved .test name that does not resolve,
# which is itself a safety net: a browser without the rule fails on DNS rather
# than reaching a real tenant.
VITE_AUTH0_DOMAIN=auth.e2e.test
VITE_AUTH0_CLIENT_ID=e2e-client-id
VITE_AUTH0_AUDIENCE=https://api.e2e.test

# VITE_API_BASE_URL is deliberately unset: it falls back to the relative
# /api/v1, which keeps REST calls same-origin, answered by the stand-in on the
# app's own server (e2e/stand-ins/api.ts). The STOMP URL derives from the same
# fallback, so the socket is ws://127.0.0.1:4173/ws/websocket, where
# e2e/stand-ins/telemetry.ts speaks STOMP.
