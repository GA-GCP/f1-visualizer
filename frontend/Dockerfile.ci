# ==========================================
# CI-Only Dockerfile: Pre-Built Vite Assets
# ==========================================
# This Dockerfile is used exclusively by Cloud Build pipelines.
# It receives the pre-built dist/ directory from the build step
# (via yarn build) and produces a minimal NGINX production image.
#
# For local development builds, use the standard Dockerfile.
# ==========================================
# Pinned by digest, and must stay identical to the nginx FROM line in
# Dockerfile: this is the image that actually serves production, and an
# unpinned `:alpine` tag silently moves across nginx minors and Alpine releases
# between two builds of the same commit. Written into the FROM line rather than
# an ARG so that Dependabot can see it (see Dockerfile).
FROM nginxinc/nginx-unprivileged:1.31.7-alpine-slim@sha256:a8cb0f33d51fa107c96fd2bd3a71aaf564ec131e9d2bdf8700944f0ed8b170d7

# Alpine's own packages, brought up to date over the pinned base — see the same
# lines in Dockerfile for why. They must stay identical in both files.
USER root
RUN apk upgrade --no-cache
USER 101

# SPA routing configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Pre-built static assets from Cloud Build
COPY dist/ /usr/share/nginx/html/

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
