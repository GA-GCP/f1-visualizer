<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.elysianarts.f1.visualizer</groupId>
        <artifactId>f1v-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>f1v-coverage</artifactId>
    <packaging>pom</packaging>
    <description>Aggregate coverage report and the floor it has to clear (T3).</description>

    <!--
      Coverage is measured across the reactor, not per module. Most of what lives
      in commons is exercised by the services that use it, so a per-module check
      reads f1v-commons-web as 0% covered while its security filter chain is
      driven by every controller slice test in the build. This module exists only
      to depend on everything and add the numbers up.
    -->
    <dependencies>
        <dependency>
            <groupId>com.elysianarts.f1.visualizer.commons</groupId>
            <artifactId>f1v-commons-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.elysianarts.f1.visualizer.commons</groupId>
            <artifactId>f1v-commons-gcp</artifactId>
        </dependency>
        <dependency>
            <groupId>com.elysianarts.f1.visualizer.commons</groupId>
            <artifactId>f1v-commons-messaging</artifactId>
        </dependency>
        <dependency>
            <groupId>com.elysianarts.f1.visualizer.commons</groupId>
            <artifactId>f1v-commons-openf1</artifactId>
        </dependency>
        <dependency>
            <groupId>com.elysianarts.f1.visualizer</groupId>
            <artifactId>f1v-service-data-analysis</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.elysianarts.f1.visualizer</groupId>
            <artifactId>f1v-service-data-ingestion</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.elysianarts.f1.visualizer</groupId>
            <artifactId>f1v-service-replay-worker</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.elysianarts.f1.visualizer</groupId>
            <artifactId>f1v-service-telemetry</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.elysianarts.f1.visualizer</groupId>
            <artifactId>f1v-service-user</artifactId>
            <version>${revision}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <!-- The per-module check is disabled here; this module has no
                         code of its own to cover. -->
                    <execution>
                        <id>check</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>aggregate-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/site/jacoco-aggregate</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>aggregate-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFileIncludes>
                                <dataFileInclude>**/target/jacoco.exec</dataFileInclude>
                            </dataFileIncludes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.coverage}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.coverage}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
