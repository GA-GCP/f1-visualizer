{
  "name": "f1v-webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build --mode e2e && pnpm test:e2e:desktop && pnpm test:e2e:mobile",
    "test:e2e:desktop": "F1V_E2E_PLATFORM=desktop vitest run --config vitest.e2e.config.ts",
    "test:e2e:mobile": "F1V_E2E_PLATFORM=mobile vitest run --config vitest.e2e.config.ts",
    "e2e:chrome": "node e2e/chrome.ts",
    "screenshots": "pnpm build --mode e2e && F1V_E2E_PLATFORM=desktop vitest run --config vitest.screenshots.config.ts && F1V_E2E_PLATFORM=mobile vitest run --config vitest.screenshots.config.ts && pnpm screenshots:compose",
    "screenshots:compose": "node e2e/screenshots.compose.ts",
    "size": "size-limit"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.30.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/titillium-web": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/utils": "^9.5.0",
    "@stomp/stompjs": "^7.5.0",
    "@tanstack/react-query": "^5.106.1",
    "axios": "^1.21.0",
    "d3": "^7.9.2",
    "framer-motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/webdriverjs": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^14.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/selenium-webdriver": "^4.35.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "canvas": "^3.2.3",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jest-image-snapshot": "^6.5.2",
    "jsdom": "^30.1.3",
    "oxc-transform-react": "^0.157.0",
    "prettier": "^3.9.10",
    "selenium-webdriver": "^4.52.0",
    "size-limit": "^14.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0",
    "ws": "^8.22.0"
  }
}
